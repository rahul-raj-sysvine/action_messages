<div class="container mx-auto p-4">
  <h1 class="text-2xl font-bold mb-4">Chat Room</h1>
  <div id="messages" class="mb-4">
    <%= render @messages %>
  </div>
  <div class="flex">
    <input type="text" id="chat-input" class="flex-1 p-2 border rounded-l">
    <input hidden="true" type="text" id="user-chat-input" class="flex-1 p-2 border rounded-l" value="<%= authenticated?.try(:user_id) %>">

    <button id="send-button" class="bg-blue-500 text-white p-2 rounded-r">Send</button>
  </div>
</div>


